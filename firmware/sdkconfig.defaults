# SPDX-License-Identifier: Apache-2.0
CONFIG_COMPILER_CXX_EXCEPTIONS=y

# The managed lvgl/lvgl component's ESP-IDF Kconfig defaults
# LV_BUILD_EXAMPLES to "on" (see managed_components/lvgl__lvgl/Kconfig),
# which compiles LVGL's entire examples/ tree into the build for no reason
# -- firmware/ui/ never references it. Off here mirrors the simulator's
# CMake FetchContent build, which already sets LV_BUILD_EXAMPLES/
# LV_BUILD_DEMOS off directly.
CONFIG_LV_BUILD_EXAMPLES=n

# ESP-IDF's default main-task stack (3584 bytes) is too small for this
# firmware: app_main()'s own for(;;) loop runs LVGL rendering, our
# diagnostic/calibration screen-building code, and NVS access all
# directly on that one task, never on a dedicated task with its own
# stack. Confirmed on the real board as a genuine stack overflow
# (vApplicationStackOverflowHook firing) the first time the diagnostic
# screen was actually built and rendered (BuildDiagnosticScreen's per-
# peripheral lv_label_set_text_fmt calls plus LVGL's own render call
# stack). DRAM headroom is ample (~76KB free per ./dev build firmware's
# size report), so this is a generous bump, not a tight fit.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384

# The lcdwiki-esp32-32e-2.8 board carries a 4 MB flash part (profile.toml
# flash_mb = 4; verified with `esptool.py flash_id`: "Detected flash size:
# 4MB"). ESP-IDF's default is 2 MB with a 1 MiB single-app partition, which
# the M1a capacity probes mistook for a hardware limit. Use the whole part
# and the project's own partition table (ADR 0010: internal-flash state in
# dedicated partitions).
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"
CONFIG_PARTITION_TABLE_SINGLE_APP=n
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# F08 Work item 2 needs measured CPU load under combined radio/UI load, not
# an estimate. FreeRTOS's own per-task runtime counters are the only source
# for that on this target; they default off. The esp_timer-clocked variant
# (the Kconfig default) costs one esp_timer_get_time() read per context
# switch, which is negligible next to the radio/LVGL work already running.
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_VTASKLIST_INCLUDE_COREID=y

# TB09: the product radio. Controller-only BLE (VHCI, no NimBLE or Bluedroid
# host: the radio code speaks HCI itself and only scans passively) and passive
# 802.11 reception (WIFI_MODE_NULL plus promiscuous mode), promoted from the F08
# probe overlays (sdkconfig.controller_only_probe.defaults and
# sdkconfig.passive_wifi_probe.defaults, kept for the historical reproductions).
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=n
CONFIG_BT_CONTROLLER_ONLY=y
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=y
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=n
CONFIG_BTDM_CTRL_MODE_BTDM=n
CONFIG_BTDM_CTRL_HCI_MODE_VHCI=y
CONFIG_BTDM_CTRL_FULL_SCAN_SUPPORTED=y

# Core pinning as measured in F08: the BLE controller on core 0 with the UI, the
# Wi-Fi task and our radio and HCI tasks on core 1.
CONFIG_BTDM_CTRL_PINNED_TO_CORE_0=y
CONFIG_ESP_WIFI_ENABLED=y
CONFIG_ESP_WIFI_TASK_PINNED_TO_CORE_0=n
CONFIG_ESP_WIFI_TASK_PINNED_TO_CORE_1=y

# Wi-Fi and BLE time-share one radio: software coexistence arbitrates them.
CONFIG_ESP_COEX_ENABLED=y
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y

# Receive-only Wi-Fi: no station, AP or enterprise features, no stored
# credentials, no transmit aggregation. The IRAM options stay off as measured in F08.
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=n
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=y
CONFIG_ESP_WIFI_NVS_ENABLED=n
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_ESP_WIFI_ENABLE_WPA3_SAE=n
CONFIG_ESP_WIFI_ENABLE_SAE_PK=n
CONFIG_ESP_WIFI_ENABLE_WPA3_OWE_STA=n
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=n
CONFIG_ESP_WIFI_ENTERPRISE_SUPPORT=n
CONFIG_ESP_WIFI_MBEDTLS_TLS_CLIENT=n
