# SPDX-License-Identifier: Apache-2.0
CONFIG_COMPILER_CXX_EXCEPTIONS=y

# The managed lvgl/lvgl component's ESP-IDF Kconfig defaults
# LV_BUILD_EXAMPLES to "on" (see managed_components/lvgl__lvgl/Kconfig),
# which compiles LVGL's entire examples/ tree into the build for no reason
# -- firmware/ui/ never references it. Off here mirrors the simulator's
# CMake FetchContent build, which already sets LV_BUILD_EXAMPLES/
# LV_BUILD_DEMOS off directly.
CONFIG_LV_BUILD_EXAMPLES=n

# ESP-IDF's default main-task stack (3584 bytes) is too small for this
# firmware: app_main()'s own for(;;) loop runs LVGL rendering, our
# diagnostic/calibration screen-building code, and NVS access all
# directly on that one task, never on a dedicated task with its own
# stack. Confirmed on the real board as a genuine stack overflow
# (vApplicationStackOverflowHook firing) the first time the diagnostic
# screen was actually built and rendered (BuildDiagnosticScreen's per-
# peripheral lv_label_set_text_fmt calls plus LVGL's own render call
# stack). DRAM headroom is ample (~76KB free per ./dev build firmware's
# size report), so this is a generous bump, not a tight fit.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
