<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.cydsystemmonitor.hostd</string>
	<key>ProgramArguments</key>
	<array>
		<string>/opt/cyd/bin/cyd-hostd</string>
		<string>--log-dir</string>
		<string>/Users/example/Library/Logs/CYD System Monitor</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>ProcessType</key>
	<string>Adaptive</string>
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<key>LimitLoadToSessionType</key>
	<string>Aqua</string>
	<key>StandardOutPath</key>
	<string>/Users/example/Library/Logs/CYD System Monitor/hostd-launchd.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/example/Library/Logs/CYD System Monitor/hostd-launchd.log</string>
</dict>
</plist>
