{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "herdr agent report --agent codex --state working"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/opt/cyd/cyd-host' agent-event codex busy 2>/dev/null || true",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "herdr agent report --agent codex --state idle"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/opt/cyd/cyd-host' agent-event codex idle 2>/dev/null || true",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/opt/cyd/cyd-host' agent-event codex busy 2>/dev/null || true",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/opt/cyd/cyd-host' agent-event codex busy 2>/dev/null || true",
            "timeout": 5
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/opt/cyd/cyd-host' agent-event codex idle 2>/dev/null || true",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/opt/cyd/cyd-host' agent-event codex idle 2>/dev/null || true",
            "timeout": 5
          }
        ]
      }
    ],
    "Interrupt": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/opt/cyd/cyd-host' agent-event codex idle 2>/dev/null || true",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
